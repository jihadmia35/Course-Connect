# Runtime: prefer the dashboard transaction pooler URL (6543); percent-encode passwords.
# Vercel automatically normalizes Supabase session-pooler port 5432 to 6543.
# TLS example suffix: ?sslmode=verify-full&sslrootcert=supabase%2Fprod-ca-2021.crt
DATABASE_URL=""
# Prisma migration CLI: direct Postgres or Supabase session pooler (5432).
DIRECT_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server only: needed only for faculty Storage uploads. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
# Optional origin override for custom reverse proxies; omit on Vercel and localhost.
# APP_URL="https://your-custom-domain.example"
# Random 32+ byte secret used for form HMACs and pseudonymous rate-limit keys.
RATE_LIMIT_SECRET=""
# Optional: shared abuse protection without PostgreSQL lookups for blocked requests.
# Both server-only values are required together. Without them the existing database
# persists bans; a bounded in-memory denial cache skips repeat checks per instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Explicit source semester for CLI import; never inferred from today's date.
IMPORT_SEMESTER="Fall - 2026"
# Existing Supabase Auth user UUID for admin grant and normal CLI imports.
# Initial data loading can use --database-operator without an Auth account.
ADMIN_USER_ID=""
